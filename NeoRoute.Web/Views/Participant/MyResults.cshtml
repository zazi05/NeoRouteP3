@{
    ViewData["Title"] = "My Results";
}
<div class="page-hero">
    <h1><i class="bi bi-award me-2"></i>My Results</h1>
    <p class="lead mb-0">Your race times and positions.</p>
</div>
<div id="list">
    <p class="text-muted loading-pulse">Loading...</p>
</div>
<script>
    const data = @Html.Raw(ViewBag.ResultsJson ?? "[]");
    const el = document.getElementById("list");
    if (Array.isArray(data) && data.length) {
        el.innerHTML = data.map(e => `<div class="card mb-3 p-3 shadow-sm">${JSON.stringify(e)}</div>`).join("");
    } else {
        el.innerHTML = `<div class="empty-state card"><i class="bi bi-award"></i><h5>No results yet</h5><p class="mb-0">Results will show after organisers publish them.</p></div>`;
    }
</script>
