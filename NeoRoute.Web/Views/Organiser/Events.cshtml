@{
    ViewData["Title"] = "Manage Events";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="mb-0"><i class="bi bi-calendar-event text-raceday me-2"></i>My Events</h2>
    <a class="btn btn-raceday" asp-action="CreateEvent"><i class="bi bi-plus-lg me-1"></i> Create Event</a>
</div>

<div id="eventsList" class="list-group">
    <p class="text-muted loading-pulse"><i class="bi bi-hourglass-split me-1"></i> Loading events from API...</p>
</div>

<script>
    const data = @Html.Raw(ViewBag.EventsJson ?? "[]");
    const container = document.getElementById("eventsList");
    if (Array.isArray(data) && data.length > 0) {
        container.innerHTML = data.map(e => `
            <div class="list-group-item">
                <div class="d-flex w-100 justify-content-between">
                    <h5 class="mb-1">${e.name || e.Name || "Event"}</h5>
                    <small class="text-muted">${e.date || e.Date || ""}</small>
                </div>
                <p class="mb-1 text-muted">${e.description || e.Description || ""}</p>
                <small><i class="bi bi-geo-alt text-accent"></i> ${e.location || e.Location || "TBA"}</small>
            </div>
        `).join("");
    } else {
        container.innerHTML = `
            <div class="empty-state card">
                <i class="bi bi-calendar-plus"></i>
                <h5>No events found</h5>
                <p class="mb-3">Create your first race event to get started.</p>
                <a class="btn btn-raceday" href="/Organiser/CreateEvent">+ Create Event</a>
            </div>`;
    }
</script>
