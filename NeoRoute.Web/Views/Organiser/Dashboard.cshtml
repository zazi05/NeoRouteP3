@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="page-hero">
    <h1><i class="bi bi-speedometer2 me-2"></i>Organiser Dashboard</h1>
    <p class="lead mb-0">Manage your races, enrolments and results from one place.</p>
</div>

<div class="alert alert-info">
    <i class="bi bi-info-circle me-1"></i>
    Welcome! Use the cards below or the navigation above to manage Events, Enrolments and Results.
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card dash-card h-100">
            <div class="card-body">
                <div class="dash-icon"><i class="bi bi-calendar-event"></i></div>
                <h5>Events</h5>
                <p class="text-muted small">Create and manage your race events.</p>
                <a class="btn btn-raceday" asp-action="Events">Manage Events</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card dash-card h-100">
            <div class="card-body">
                <div class="dash-icon"><i class="bi bi-people"></i></div>
                <h5>Enrolments</h5>
                <p class="text-muted small">View participants enrolled in your events.</p>
                <a class="btn btn-raceday" asp-action="Enrolments">View Enrolments</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card dash-card h-100">
            <div class="card-body">
                <div class="dash-icon"><i class="bi bi-flag"></i></div>
                <h5>Results</h5>
                <p class="text-muted small">Enter and publish race results.</p>
                <a class="btn btn-raceday" asp-action="Results">Enter Results</a>
            </div>
        </div>
    </div>
</div>
