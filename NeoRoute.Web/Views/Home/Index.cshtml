@{
    ViewData["Title"] = "Home";
}

<div class="page-hero text-center">
    <h1 class="display-5"><i class="bi bi-trophy-fill text-accent me-2"></i>Welcome to RaceDay</h1>
    <p class="lead">Find and join running events near you. Organise races. Track results.</p>
</div>

<div id="eventsList" class="row g-4">
    <div class="col-12">
        <p class="text-muted loading-pulse text-center"><i class="bi bi-hourglass-split me-1"></i> Loading events...</p>
    </div>
</div>

<script>
    const data = @Html.Raw(ViewBag.EventsJson ?? "[]");
    const container = document.getElementById("eventsList");
    if (Array.isArray(data) && data.length > 0) {
        container.innerHTML = data.map(e => {
            const name = e.eventName || e.EventName || "Event";
            const desc = e.description || e.Description || "No description provided.";
            const date = e.eventDate || e.EventDate;
            const loc = e.location || e.Location || "TBA";
            const dist = e.distance || e.Distance || "";
            const type = e.eventType || e.EventType || "";
            const img = e.imageUrl || e.ImageUrl;
            const imgHtml = img
                ? `<img src="${img}" class="card-img-top" alt="${name}" style="height:160px;object-fit:cover;">`
                : `<div class="card-img-top bg-secondary d-flex align-items-center justify-content-center text-white" style="height:160px;"><i class="bi bi-image display-4"></i></div>`;
            return `
            <div class="col-md-6 col-lg-4">
                <div class="card event-card h-100">
                    ${imgHtml}
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">${name}</h5>
                        <p class="card-text flex-grow-1">${desc}</p>
                        <div class="event-meta mt-2">
                            <div><i class="bi bi-calendar3"></i> ${date ? new Date(date).toLocaleString() : "TBA"}</div>
                            <div><i class="bi bi-geo-alt"></i> ${loc}</div>
                            ${dist ? `<div><i class="bi bi-signpost"></i> ${dist}</div>` : ""}
                            ${type ? `<div><i class="bi bi-flag"></i> ${type}</div>` : ""}
                        </div>
                    </div>
                </div>
            </div>`;
        }).join("");
    } else {
        container.innerHTML = `
            <div class="col-12">
                <div class="empty-state card p-4 text-center">
                    <i class="bi bi-calendar-x display-4 text-muted"></i>
                    <h5 class="mt-2">No events available yet</h5>
                    <p class="mb-0 text-muted">Log in as an <strong>Organiser</strong> to create the first race.</p>
                </div>
            </div>`;
    }
</script>
