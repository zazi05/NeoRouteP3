@{
    var isLoggedIn = Context.Session.GetString("IsLoggedIn") == "true";
    var userRole = Context.Session.GetString("UserRole") ?? "";
    var userEmail = Context.Session.GetString("UserEmail") ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay | NeoRoute</title>

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- RaceDay custom styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-raceday">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-trophy-fill brand-accent"></i>
                    Race<span class="brand-accent">Day</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>

                        @if (isLoggedIn && userRole == "Organiser")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Organiser" asp-action="Events">
                                    <i class="bi bi-calendar-event me-1"></i> Events
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Organiser" asp-action="Enrolments">
                                    <i class="bi bi-people me-1"></i> Enrolments
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Organiser" asp-action="Results">
                                    <i class="bi bi-flag me-1"></i> Results
                                </a>
                            </li>
                        }

                        @if (isLoggedIn && userRole == "Participant")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Participant" asp-action="MyEnrolments">
                                    <i class="bi bi-ticket-perforated me-1"></i> My Enrolments
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Participant" asp-action="MyResults">
                                    <i class="bi bi-award me-1"></i> My Results
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Participant" asp-action="Profile">
                                    <i class="bi bi-person-circle me-1"></i> Profile
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        @if (isLoggedIn)
                        {
                            <li class="nav-item d-flex align-items-center">
                                <span class="nav-link disabled text-white-50 small">
                                    <i class="bi bi-person-fill me-1"></i>@userEmail
                                    @if (!string.IsNullOrEmpty(userRole))
                                    {
                                        <span class="role-badge">@userRole</span>
                                    }
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container text-center">
            &copy; 2026 RaceDay by NeoRoute &middot;
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
